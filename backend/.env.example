# Aqua-Sol Energy - Backend Production & Local Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=production

# MongoDB Database URI (REQUIRED for Vercel: Use MongoDB Atlas connection string)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/aqua_sol_energy?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aqua_sol_energy?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong random 32+ char secret)
JWT_SECRET=aquasol_energy_jwt_secret_production_random_key_2026
JWT_EXPIRE=30d

# Allowed Frontend Client URLs for CORS (comma-separated if multiple)
# Set this to your deployed Vercel frontend URL
CLIENT_URL=https://aqua-sol-frontend.vercel.app,http://localhost:5173

# Optional Cloud Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Business & Email Notification (Optional)
WHATSAPP_NUMBER=+918275067701
ADMIN_EMAIL=aquasolpune@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
