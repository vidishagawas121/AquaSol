# ==============================================================================
# Aqua-Sol Energy Production Backend - Environment Configuration
# ==============================================================================

# Port to listen on (for Node.js runtime / local / VM deployments)
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# Comma-separated allowed Frontend domains for CORS
CLIENT_URL=https://aqua-sol-wheat.vercel.app,https://aqua-sol-frontend.vercel.app,http://localhost:5173

# MongoDB Atlas Database Connection URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/aquasol?retryWrites=true&w=majority)
# If left blank, Aqua-Sol gracefully functions in zero-database standalone mode.
MONGODB_URI=

# Custom DNS resolvers for MongoDB Atlas SRV lookup reliability (comma-separated)
DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1,1.0.0.1

# MongoDB Connection Timeout in Milliseconds
MONGODB_TIMEOUT_MS=5000

# JWT Authentication Secret Key & Expiration
JWT_SECRET=aquasol_energy_jwt_secret_production_2026_secure_key
JWT_EXPIRE=30d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LEAD_RATE_LIMIT_WINDOW_MS=900000
LEAD_RATE_LIMIT_MAX=20

# Max HTTP Request Payload Body Size (e.g. 10mb)
MAX_BODY_SIZE=10mb

# Business Contact & Lead Routing
WHATSAPP_NUMBER=+918275067701
ADMIN_EMAIL=aquasolpune@gmail.com
